DJANGO_SECRET_KEY=change-me-to-a-unique-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Google Calendar "secret address" (iCal format) for the Roshan League
# fixture calendar used by the "Update Roshan League Schedule" admin button
# (matches/calendar_sync.py). Use the SECRET address, not the public one -
# the public "basic.ics" address for this calendar returns zero events.
# Find it in Google Calendar under Settings > [calendar] > "Secret address
# in iCal format". Never commit the real value - this file only holds a
# placeholder.
MATCH_CALENDAR_ICAL_URL=change-me-to-the-secret-ical-url